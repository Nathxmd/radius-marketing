# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=radius_sistem
DB_USER=root
DB_PASSWORD=

# Application Configuration
APP_NAME="Radius Sistem"
APP_URL=http://localhost/radius-sistem
TIMEZONE=Asia/Jakarta

# Nominatim API
NOMINATIM_USER_AGENT="rumahbirudigital@gmail.com"

# CA bundle untuk curl (opsional; kosong = pakai bawaan PHP).
# Isi path ke cacert.pem jika di environment muncul error SSL "unable to get local issuer certificate".
CURL_CAINFO=

# Referral integration (keep the real values only in .env, never in git)
EXTERNAL_APP_PUSH_URL=https://aplikasi-eksternal.example.com/api/referrals/sync
EXTERNAL_APP_API_KEY=
REFERRAL_SHARED_SECRET=generate-a-random-secret-at-least-32-characters
