# ============================================================
# Radius Sistem - Contoh .env untuk DEPLOYMENT (cPanel)
# ============================================================
# 1. Buka cPanel -> MySQL Databases, buat database + user,
#    lalu beri user akses PRIVILEGES ALL ke database.
#    Contoh: DB_NAME=username_radius, DB_USER=username_radius

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rumahbir_radius_sistem
DB_USER=rumahbir_wpradius
DB_PASSWORD=

# Application Configuration
# GANTI dengan URL subdomain kamu, TANPA trailing slash.
# Contoh: APP_URL=https://radius.domainkamu.com
APP_NAME="Radius Sistem"
APP_URL=GANTI_https://radiusmarketing.rumahbiru.id
TIMEZONE=Asia/Jakarta

# Nominatim API - ganti dengan email kamu (wajib jelas agar
# tidak diblokir OpenStreetMap)
NOMINATIM_USER_AGENT=rumahbirudigital@gmail.com

# CA bundle untuk curl. Di hosting biasanya TIDAK perlu
# (kosongkan saja). Kalau muncul error SSL saat geocoding,
# upload config/cacert.pem dan isi path absolutnya.
CURL_CAINFO=

# Referral integration
EXTERNAL_APP_PUSH_URL=https://aplikasi-eksternal.example.com/api/referrals/sync
EXTERNAL_APP_API_KEY=
REFERRAL_SHARED_SECRET=generate-a-random-secret-at-least-32-characters
